#!/bin/bash
# home-manager-setup.sh - 自动化设置 LiMac Home Manager（个人配置外置版）

set -euo pipefail  # 遇错即退；未定义变量报错；管道错误传播

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

SELF="${BASH_SOURCE[0]:-$0}"
if [ -L "$SELF" ]; then
  FWDIR=$(dirname "$(readlink "$SELF")")
else
  FWDIR=$(dirname "$SELF")
fi
project_dir="$(cd "${FWDIR}/.."; pwd)"
cd "$project_dir"

# 日志函数
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 检查依赖
check_dependencies() {
    log_info "检查系统依赖..."

    if ! command -v nix &> /dev/null; then
        log_error "Nix 未安装。请先安装 Nix。"
        exit 1
    fi

    if ! command -v git &> /dev/null; then
        log_error "Git 未安装。请先安装 Git。"
        exit 1
    fi

    log_success "依赖检查通过"
}

# 幂等追加一行到 nix.conf（已存在则跳过），避免覆盖用户已有配置
append_nix_conf_line() {
    local line="$1"
    local nix_conf=~/.config/nix/nix.conf

    if grep -qxF "$line" "$nix_conf" 2>/dev/null; then
        return 0
    fi

    printf '%s\n' "$line" >> "$nix_conf"
}

# 启用 Nix 实验性功能
enable_experimental_features() {
    log_info "启用 Nix 实验性功能..."

    mkdir -p ~/.config/nix
    local nix_conf=~/.config/nix/nix.conf

    # 备份已有配置，避免覆盖用户的 substituters / trusted-public-keys 等
    if [ -f "$nix_conf" ]; then
        local backup="${nix_conf}.bak.$(date +%Y%m%d-%H%M%S)"
        cp "$nix_conf" "$backup"
        log_warning "已备份现有 nix.conf 到 $backup"
    fi

    append_nix_conf_line 'experimental-features = nix-command flakes'

    log_success "Nix 实验性功能已启用"
}

# 根据当前系统确定 flake 配置名
get_system_name() {
    local os_type
    local machine
    os_type="$(uname -s | tr '[:upper:]' '[:lower:]')"
    machine="$(uname -m)"

    case "$os_type" in
        linux)
            case "$machine" in
                x86_64)        echo "x86_64-linux" ;;
                aarch64|arm64) echo "aarch64-linux" ;;
                *)             echo "x86_64-linux" ;;
            esac
            ;;
        darwin)
            case "$machine" in
                x86_64)        echo "x86_64-darwin" ;;
                aarch64|arm64) echo "aarch64-darwin" ;;
                *)             echo "aarch64-darwin" ;;
            esac
            ;;
        *)
            echo "x86_64-linux"
            ;;
    esac
}

# 检测当前是否为 WSL/WSL2 环境（macOS 直接排除）
detect_is_wsl() {
    if [ "${IS_DARWIN:-false}" = true ]; then
        return 1
    fi
    grep -qEi "(Microsoft|WSL)" /proc/version 2>/dev/null || [ -f /proc/sys/fs/binfmt_misc/WSLPersonal ]
}

# WSL 专属 profiles 优化块（generate_host_config 与 ensure_wsl_profiles 共用的单一来源）
wsl_profiles_block() {
    cat << 'EOF'
  profiles = {
    embedded.enable = false;   # WSL 环境下不直接物理调试板子
    containers.enable = false; # WSL 环境下建议与 Windows 的 Docker Desktop 整合
  };
EOF
}

# 交互式配置并生成本地 host 文件
generate_host_config() {
    local current_user
    current_user=$(whoami)
    local local_config_dir="$HOME/.config/limac"
    local host_file="$local_config_dir/host.nix"

    if [ -f "$host_file" ]; then
        log_info "检测到已存在本地 Host 配置文件: $host_file，将直接使用该配置。"
        return 0
    fi

    log_info "开始为用户 '$current_user' 创建本地 Host 配置文件..."

    # 获取 Git 默认信息
    local git_username=""
    local git_email=""

    if command -v git &> /dev/null; then
        git_username=$(git config --global user.name || echo "")
        git_email=$(git config --global user.email || echo "")
    fi

    echo
    log_info "请输入配置信息（按 Enter 使用默认值或现有值）"

    read -p "Git 用户名 [${git_username:-暂无}]: " input_git_username
    git_username=${input_git_username:-$git_username}

    read -p "Git 邮箱 [${git_email:-暂无}]: " input_git_email
    git_email=${input_git_email:-$git_email}

    # 验证必要信息
    if [ -z "$git_username" ]; then
        log_error "Git 用户名是必需的"
        exit 1
    fi

    if [ -z "$git_email" ]; then
        log_error "Git 邮箱是必需的"
        exit 1
    fi

    log_info "正在生成 $host_file..."

    mkdir -p "$local_config_dir"

    # 检测是否为 WSL
    local is_wsl=false
    if detect_is_wsl; then
        is_wsl=true
    fi

    local use_wsl_optimization=false
    if [ "$is_wsl" = true ]; then
        use_wsl_optimization=$(ask_wsl_optimization)
    fi

    # 三种场景生成的 host.nix 仅 WSL 优化块存在与否这一处差异，统一为一份模板
    local wsl_block=""
    if [ "$use_wsl_optimization" = true ]; then
        wsl_block="
$(wsl_profiles_block)
"
    fi

    cat > "$host_file" << EOF
{
  home.username = "${current_user}";
${wsl_block}
  programs.git.settings = {
    user.name = "${git_username}";
    user.email = "${git_email}";
  };
}
EOF

    log_success "本地 Host 配置文件已成功生成: $host_file"
}

# 询问是否启用 WSL 专属优化（仅在 WSL 环境下调用）
# 注意：调用方通过 $(...) 捕获本函数返回值，除最后一行 echo 外的所有输出必须走 stderr
ask_wsl_optimization() {
    local use_wsl_optimization=false

    echo >&2
    log_info "检测到您当前运行在 WSL/WSL2 (Windows Subsystem for Linux) 环境中。" >&2
    log_info "在 WSL2 环境下，推荐使用 Windows 宿主机的 VS Code (通过 WSL Remote 插件) 和宿主机 Docker Desktop，" >&2
    log_info "并且通常不需要物理调试的嵌入式开发工具。" >&2
    echo >&2
    while true; do
        read -p "是否为您应用 WSL 专属优化（关闭 GUI 软件、嵌入式工具和本地 Docker，只保留核心基础工具与语言级开发包）？[Y/n]: " input_wsl
        case "${input_wsl:-Y}" in
            [Yy]*)
                use_wsl_optimization=true
                break
                ;;
            [Nn]*)
                use_wsl_optimization=false
                break
                ;;
            *)
                log_warning "请输入 y 或 n" >&2
                ;;
        esac
    done

    echo "$use_wsl_optimization"
}

# 幂等保障：WSL 环境下若既有 host.nix 缺少 profiles 优化块，询问用户后补齐
ensure_wsl_profiles() {
    local host_file="$HOME/.config/limac/host.nix"

    detect_is_wsl || return 0

    if [ ! -f "$host_file" ]; then
        return 0
    fi

    if grep -q 'embedded\.enable' "$host_file"; then
        return 0
    fi

    log_warning "检测到 WSL 环境，但 $host_file 缺少 profiles 优化块（嵌入式/容器工具将被安装）。"
    while true; do
        read -p "是否为该文件补齐 WSL 专属 profiles 优化块？[Y/n]: " input_fix
        case "${input_fix:-Y}" in
            [Yy]*)
                break
                ;;
            [Nn]*)
                log_info "已跳过。如后续需要，可手动在 $host_file 中添加 profiles 块。"
                return 0
                ;;
            *)
                log_warning "请输入 y 或 n"
                ;;
        esac
    done

    local backup="${host_file}.bak.$(date +%Y%m%d-%H%M%S)"
    cp "$host_file" "$backup"
    log_info "已备份现有 host.nix 到 $backup"

    awk -v block="$(wsl_profiles_block)" '
        /^}/ && done == 0 {
            print ""
            print block
            done = 1
        }
        { print }
    ' "$host_file" > "${host_file}.tmp" && mv "${host_file}.tmp" "$host_file"

    log_success "已在 $host_file 中补齐 WSL profiles 优化块"
}

# 检查 Nix daemon 可访问性（多用户安装常见权限问题）
check_nix_daemon_access() {
    log_info "检查 Nix daemon 连接..."

    if nix store info >/dev/null 2>&1; then
        log_success "Nix daemon 连接正常"
        return 0
    fi

    # 常见 Debian 多用户安装：daemon-socket 目录对 nix-users 组开放
    if [ -d "/nix/var/nix/daemon-socket" ]; then
        local socket_dir="/nix/var/nix/daemon-socket"
        local dir_group
        dir_group=$(stat -c '%G' "$socket_dir" 2>/dev/null || true)

        if [ "$dir_group" = "nix-users" ]; then
            local current_user
            current_user=$(whoami)

            if getent group nix-users | grep -qw "$current_user"; then
                if ! id -nG | grep -qw nix-users; then
                    log_error "当前 shell 未加载 'nix-users' 用户组权限。"
                    log_info "你已经是 'nix-users' 组成员，但当前会话尚未生效。"
                    log_info "请执行以下命令后重新运行本脚本："
                    echo ""
                    echo -e "  ${YELLOW}newgrp nix-users${NC}"
                    echo ""
                    log_info "或者注销并重新登录。"
                    exit 1
                fi
            else
                log_error "当前用户不在 'nix-users' 组中，无法访问 Nix daemon socket。"
                log_info "请执行以下命令（执行后需要注销并重新登录）："
                echo ""
                echo -e "  ${YELLOW}sudo usermod -aG nix-users ${current_user}${NC}"
                echo ""
                exit 1
            fi
        fi
    fi

    log_error "无法连接到 Nix daemon，请检查 Nix 安装状态。"
    exit 1
}

# 应用 Home Manager 配置
apply_home_manager() {
    log_info "应用 Home Manager 配置, 配置名: $SYSTEM_NAME"

    # 使用 --impure 以允许 flake 读取仓库外的 ~/.config/limac/host.nix
    nix run "nixpkgs#home-manager" -- switch --flake ".#$SYSTEM_NAME" --impure

    log_success "Home Manager 配置应用完成"
}

# 配置 Konsole
configure_konsole() {
    if [ "$IS_DARWIN" = true ]; then
        log_info "macOS 跳过 Konsole 配置"
        return
    fi

    if ! command -v konsole &> /dev/null; then
        log_warning "Konsole 未安装，跳过配置"
        return
    fi

    local current_user
    current_user=$(whoami)
    local fish_path="/home/$current_user/.nix-profile/bin/fish"

    if [ ! -f "$fish_path" ]; then
        log_warning "Fish shell 未找到，跳过 Konsole 配置"
        return
    fi

    log_info "配置 Konsole..."

    # 创建 Konsole 配置目录
    mkdir -p ~/.local/share/konsole

    # 创建自定义 profile
    cat > ~/.local/share/konsole/LiMac.profile << EOF
[General]
Command=$fish_path
Name=LiMac
Parent=FALLBACK/
EOF

    log_success "Konsole 配置已创建"
    log_info "请在 Konsole 中手动选择 LiMac profile:"
    log_info "1. 点击右上角菜单按钮"
    log_info "2. 选择 'Create New Profile...'"
    log_info "3. 选择 LiMac profile"
    log_info "4. 设置为默认 profile (可选)"
}

# 显示完成信息
show_completion() {
    local current_user
    current_user=$(whoami)

    local fish_path
    if [ "$IS_DARWIN" = true ]; then
        fish_path="/Users/$current_user/.nix-profile/bin/fish"
    else
        fish_path="/home/$current_user/.nix-profile/bin/fish"
    fi

    echo
    log_success "Home Manager 设置完成！"
    echo
    log_info "后续操作："
    log_info "1. 格式化配置: nix fmt"
    log_info "2. 更新配置: nix run \"nixpkgs#home-manager\" -- switch --flake .#$SYSTEM_NAME --impure"
    log_info "3. 查看新闻: home-manager news"
    echo
    log_info "重要提示："
    log_info "- Fish shell 路径: $fish_path"
    log_info "- 请在终端中手动配置使用此 shell"
    if [ "$IS_DARWIN" = true ]; then
        log_info "- macOS 上请在终端/iTerm2/VSCode 中配置"
    else
        log_info "- 推荐在 Konsole 中设置 LiMac profile"
    fi
    echo
    if [ "$IS_DARWIN" = true ]; then
        log_info "macOS 不支持 systemd，无需清理服务"
    else
        log_info "如果遇到 systemd 服务错误，请运行:"
        log_info "systemctl --user reset-failed"
        log_info "systemctl --user daemon-reload"
    fi
}

# 清理失败的 systemd 服务（预防性）
cleanup_systemd_services() {
    if [ "$IS_DARWIN" = true ]; then
        log_info "macOS 不支持 systemd，跳过清理"
        return
    fi

    log_info "清理可能的 systemd 服务问题..."

    # 重置失败的 systemd 服务
    systemctl --user reset-failed 2>/dev/null || true
    systemctl --user daemon-reload 2>/dev/null || true

    log_success "systemd 服务清理完成"
}

# 主函数
main() {
    echo -e "${BLUE}"
    cat << "EOF"
██╗     ██╗███╗   ███╗ █████╗  ██████╗
██║     ██║████╗ ████║██╔══██╗██╔════╝
██║     ██║██╔████╔██║███████║██║
██║     ██║██║╚██╔╝██║██╔══██║██║
███████╗██║██║ ╚═╝ ██║██║  ██║╚██████╗
╚══════╝╚═╝╚═╝     ╚═╝╚═╝  ╚═╝ ╚═════╝
EOF
    echo -e "${NC}"

    OS_TYPE="$(uname | tr '[:upper:]' '[:lower:]')"
    IS_DARWIN=false
    if [ "$OS_TYPE" = "darwin" ]; then
        IS_DARWIN=true
    fi
    SYSTEM_NAME=$(get_system_name)

    log_info "开始设置 LiMac Home Manager"
    log_info "检测到平台: $(uname) ($OS_TYPE / $(uname -m))"

    # 执行步骤
    check_dependencies
    check_nix_daemon_access
    enable_experimental_features
    generate_host_config
    ensure_wsl_profiles
    apply_home_manager
    configure_konsole
    cleanup_systemd_services
    show_completion
}

main "$@"
