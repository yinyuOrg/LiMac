#!/usr/bin/env bash

# Script to update flake.lock file
# This script updates all flake inputs and creates a backup of the old flake.lock

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

echo "Running from: $(pwd)"
echo ""

# Check if flake.nix exists
if [[ ! -f "flake.nix" ]]; then
    echo "Error: flake.nix not found in current directory: $(pwd)"
    exit 1
fi

# Create backup of current flake.lock
BACKUP_NAME=""
if [[ -f "flake.lock" ]]; then
    BACKUP_NAME="flake.lock.backup.$(date +%Y%m%d_%H%M%S)"
    echo "Creating backup: $BACKUP_NAME"
    cp flake.lock "$BACKUP_NAME"
fi

echo "Updating flake inputs..."
if ! nix flake update; then
    echo ""
    echo "❌ Flake update failed. flake.lock was not modified."
    if [[ -n "$BACKUP_NAME" && -f "$BACKUP_NAME" ]]; then
        echo ""
        echo "The backup is kept. To restore manually if needed:"
        echo "  cp $BACKUP_NAME flake.lock"
    fi
    exit 1
fi

echo ""
echo "✅ Flake inputs updated successfully!"

# Show what changed
if [[ -f "flake.lock" && -n "$BACKUP_NAME" && -f "$BACKUP_NAME" ]]; then
    echo ""
    echo "Changes in flake.lock:"
    diff -u "$BACKUP_NAME" flake.lock || true

    # Keep only the newest backup so flake.lock.backup.* files don't pile up
    for f in flake.lock.backup.*; do
        if [[ -f "$f" && "$f" != "$BACKUP_NAME" ]]; then
            rm -f "$f"
            echo "Removed old backup: $f"
        fi
    done
    echo "Backup kept: $BACKUP_NAME"
fi

echo ""
echo "Next steps:"
echo "  nix flake check --no-build"
echo "  nix run \"nixpkgs#home-manager\" -- switch --flake .#x86_64-linux --impure   (replace x86_64-linux with your system)"
echo ""
echo "Or test by building the activation package (replace x86_64-linux with your system):"
echo "  nix build .#homeConfigurations.x86_64-linux.activationPackage --impure"
